# Yes, this project has one too. It is also the smallest possible smoke test of the thing:
# if your implementation disagrees with git about these four lines, start there.
__pycache__/
*.pyc
node_modules/

# Upstream files as downloaded, kept so a rebuild costs no network. Re-fetchable in one command,
# so it is not the artefact -- `corpus/cases.json` is.
corpus/_cache*/
# Scratch probes that live next to the code for an afternoon and answer one question.
_*.py
